# PORT: Server port (default 3000)
PORT="3000"

# JWT_SECRET: Secret key used to sign admin session tokens.
# Change this to a strong random string in production.
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# SQLITE_DB_PATH: Optional custom path for the SQLite database file (useful for Docker volumes)
SQLITE_DB_PATH="./data/spmb.db"

# UPLOADS_DIR: Optional custom directory for uploaded logos, letterheads, and PDF documents
UPLOADS_DIR="./uploads"
